{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Planning Brain",
  "version": "0.1.0",
  "identifier": "dev.planbrain.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Planning Brain",
        "width": 1280,
        "height": 820
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "dmg"
    ],
    "resources": [],
    "externalBin": [
      "binaries/planbrain-backend"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}